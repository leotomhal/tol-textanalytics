		"builtin-modules": "^4.0.0",
		"esbuild": "^0.21.5",
		"eslint": "^8.57.0",
		"jsdom": "^30.0.1",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.3",
		"tsx": "^4.23.13",
